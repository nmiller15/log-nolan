---
import ThemeSelector from '../components/ThemeSelector.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Breaking Changes | Nolan Miller" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="gruvbox" data-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Breaking Changes</title>
    
    <!-- Turnstile Script -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    
    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline>
      (function() {
        let theme = 'gruvbox';
        let mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        
        try {
          const stored = localStorage.getItem('blog-theme');
          if (stored) {
            const parsed = JSON.parse(stored);
            theme = parsed.theme || theme;
            mode = parsed.mode || mode;
          }
        } catch (e) {}
        
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-mode', mode);
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <slot name="header">
        <header class="header">
          <div class="header-top">
            <a href="/" class="site-title">
              <span class="prompt">$</span>
              Breaking Changes<span class="cursor"></span>
            </a>
            <ThemeSelector />
          </div>
          <nav class="nav">
            <a href="/tags">Tags</a>
            <a href="/ai-policy">AI Policy</a>
            <a href="https://github.com/nmiller15" target="_blank" rel="noopener">GitHub</a>
          </nav>
        </header>
      </slot>
      
      <main class="main">
        <slot />
      </main>
      
      <slot name="footer">
        <footer class="footer">
          <div class="ascii-divider">/* ─────────────────────────────────────────────────── */</div>
          
          <div class="newsletter">
            <h3>Subscribe to Breaking Changes</h3>
            <p>Get new posts delivered to your inbox</p>
            <form id="newsletter-form" class="newsletter-form">
              <div class="newsletter-input-wrapper">
                <input 
                  type="email" 
                  name="email" 
                  placeholder="_" 
                  required 
                  class="newsletter-input"
                  autocomplete="email"
                />
              </div>
              <div 
                class="cf-turnstile" 
                data-sitekey="0x4AAAAAADI6EI5fJcYPhaGA"
                data-theme="dark"
              ></div>
              <button type="submit" class="newsletter-button">Subscribe</button>
            </form>
            <p id="newsletter-message" class="newsletter-message"></p>
          </div>
          
          <p class="copyright">&copy; {new Date().getFullYear()} Nolan Miller</p>
        </footer>
      </slot>
    </div>
    
    <script>
      // Newsletter form handling
      const form = document.getElementById('newsletter-form') as HTMLFormElement;
      const message = document.getElementById('newsletter-message');
      
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const email = formData.get('email');
        const turnstileResponse = formData.get('cf-turnstile-response');
        
        if (!turnstileResponse) {
          if (message) {
            message.textContent = 'Please complete the captcha';
            message.className = 'newsletter-message error';
          }
          return;
        }
        
        try {
          const response = await fetch('https://api.nolanmiller.me/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              email, 
              turnstileToken: turnstileResponse 
            }),
          });
          
          const data = await response.json();
          
          if (response.ok) {
            form.style.display = 'none';
            if (message) {
              message.textContent = data.message || 'Successfully subscribed!';
              message.className = 'newsletter-message success';
            }
          } else {
            if (message) {
              message.textContent = data.message || 'Something went wrong. Please try again.';
              message.className = 'newsletter-message error';
            }
          }
        } catch (error) {
          if (message) {
            message.textContent = 'Something went wrong. Please try again.';
            message.className = 'newsletter-message error';
          }
        }
      });
      
      // Update Turnstile theme when site theme changes
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'data-mode') {
            const mode = document.documentElement.getAttribute('data-mode');
            const turnstile = document.querySelector('.cf-turnstile');
            if (turnstile) {
              turnstile.setAttribute('data-theme', mode === 'dark' ? 'dark' : 'light');
            }
          }
        });
      });
      
      observer.observe(document.documentElement, { attributes: true });
    </script>
    
    <style is:global>
      @import '../styles/global.css';
    </style>
  </body>
</html>
