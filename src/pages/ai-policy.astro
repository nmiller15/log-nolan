---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');
const aiPolicy = pages.find(p => p.slug === 'ai-policy');

if (!aiPolicy) {
  return Astro.redirect('/404');
}

const { Content } = await aiPolicy.render();
---

<BaseLayout title="AI Policy">
  <article class="page">
    <h1>{aiPolicy.data.title}</h1>
    <div class="page-content">
      <Content />
    </div>
  </article>
</BaseLayout>
